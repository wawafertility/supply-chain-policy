#!/usr/bin/env ruby
require "tmpdir"
require_relative "../lib/licence_matcher"
require_relative "../lib/osv_scanner"
require_relative "../lib/package_archive"

class DependencyLicenceCheck
  UNVERIFIED_LICENCES = %w[UNKNOWN non-standard].freeze
  HEADINGS = %w[Licence Ecosystem Package Version Lockfile].freeze

  Violation = Data.define(:ecosystem, :name, :version, :source, :licences)

  def initialize(policy_root:, work_dir:)
    @policy_root = policy_root
    @work_dir = work_dir
    @scanner = OsvScanner.new(work_dir:)
    @matcher = LicenceMatcher.new(licence_directory: policy_root)
    @verified_files = {}
  end

  def passes?
    verified, unresolved = violations.partition { |violation| verified_from_licence_files?(violation) }
    report_verified(verified)
    report_unresolved(unresolved)
    unresolved.empty?
  end

  private

  attr_reader :policy_root, :work_dir, :scanner, :matcher, :verified_files

  def violations
    results = scanner.scan("--recursive", "--config", config, "--licenses=#{allowed_licences.join(",")}", ".")
    results.fetch("results", []).flat_map do |result|
      source = result.dig("source", "path").delete_prefix("#{Dir.pwd}/")
      result.fetch("packages").filter_map do |package|
        licences = package.fetch("license_violations", [])
        next if licences.empty?

        details = package.fetch("package")
        Violation.new(
          ecosystem: details["ecosystem"],
          name: details["name"],
          version: details["version"],
          source:,
          licences:
        )
      end
    end
  end

  def verified_from_licence_files?(violation)
    return false unless (violation.licences - UNVERIFIED_LICENCES).empty?

    contents = PackageArchive.fetch(ecosystem: violation.ecosystem, name: violation.name, version: violation.version)
    return false if contents.nil? || contents.licence_texts.empty?

    matches = contents.licence_texts.transform_values { |text| matcher.match(text) }
    verified_files[violation] = matches
    matches.values.all?
  end

  def report_verified(verified)
    return if verified.empty?

    puts "\nLicences verified from package files, because deps.dev could not classify them:"
    verified.each do |violation|
      files = verified_files.fetch(violation).map { |file, licence| "#{file} is #{licence}" }.join(", ")
      puts "  #{violation.name} #{violation.version} (#{violation.ecosystem}): #{files}"
    end
  end

  def report_unresolved(unresolved)
    if unresolved.empty?
      puts "\nEvery dependency licence is allowed or covered by an exception"
      return
    end

    rows = unresolved.map do |violation|
      [violation.licences.join(", "), violation.ecosystem, violation.name, violation.version, violation.source]
    end
    widths = HEADINGS.each_index.map { |index| ([HEADINGS] + rows).map { |row| row[index].length }.max }
    puts "\n#{unresolved.size} dependency licence violation(s); add an exception to osv-scanner.toml or remove the package:"
    ([HEADINGS] + rows).each do |row|
      puts "  #{row.each_with_index.map { |cell, index| cell.ljust(widths[index]) }.join("  ")}"
    end
  end

  def config
    File.join(work_dir, "osv-scanner.toml").tap do |path|
      repository_exceptions = File.exist?("osv-scanner.toml") ? "#{File.read("osv-scanner.toml")}\n" : ""
      File.write(path, repository_exceptions + File.read(File.join(policy_root, "osv-scanner.toml")))
    end
  end

  def allowed_licences
    File.readlines(File.join(policy_root, "licences.txt"), chomp: true)
  end
end

Dir.mktmpdir do |work_dir|
  exit DependencyLicenceCheck.new(policy_root: File.expand_path("..", __dir__), work_dir:).passes?
end
